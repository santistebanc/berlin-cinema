# TMDb API Key — get yours free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# OMDb API Key — get yours free at https://www.omdbapi.com/apikey.aspx
# Used to fetch IMDb ratings, vote counts, and Rotten Tomatoes / Metacritic scores
OMDB_API_KEY=your_omdb_api_key_here

# Full scrapes publish by default, both locally and in GitHub Actions.
# Set shadow explicitly to process observations without replacing movies.json.
PIPELINE_MODE=live

# Optional venue lookup and administrative-boundary verification (server-side only).
# Free key: https://myprojects.geoapify.com/ — keep the real key only in .env / GitHub secrets.
GEOAPIFY_API_KEY=
# Application limits, shared across source/replay/admin requests via the state ledger.
GEOAPIFY_MAX_REQUESTS_PER_RUN=80
GEOAPIFY_DAILY_CREDIT_LIMIT=1000

# Optional decision provider. Keep every key server-side (never use a VITE_ prefix).
# Default recommendation: Cloudflare Clef-flash. No key = conservative rules + local review.
DECISION_PROVIDER=cloudflare
DECISION_MODEL=clef-flash
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Alternatives: DECISION_PROVIDER=typesafe, DECISION_MODEL=jev-1.13.0
TYPESAFE_API_KEY=
# Or: DECISION_PROVIDER=openai, DECISION_MODEL=gpt-6-luna (Decisions API access required)
OPENAI_API_KEY=

# Input-only prices are configured from provider documentation. Update when changing models.
# Clef-flash 0.038; Clef 0.24; Jev 0.042; OpenAI Decisions 0.10 USD / million input tokens.
# DECISION_INPUT_USD_PER_MILLION=0.038
# Conservative USD allowance below the agreed EUR 10 ceiling; not a provider-account spending limit.
DECISION_MONTHLY_USD_LIMIT=8
# Provisional threshold; run live held-out evaluation before relying on automatic acceptance.
DECISION_THRESHOLD=0.97

# Local review binds only to 127.0.0.1. No login or hosted backend.
ADMIN_PORT=3003
# Optional override for isolated evaluation or another checkout:
# PIPELINE_STATE=/absolute/path/to/pipeline/state.json
